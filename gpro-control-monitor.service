[Unit]
Description=G PRO Control battery alerts
# Started with the user session rather than graphical-session.target, which
# many compositors (Hyprland, Sway, i3, niri, ...) never start. It only needs
# the session D-Bus; if no notification daemon is up yet it retries.

[Service]
ExecStart=/usr/bin/gpro-control monitor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
